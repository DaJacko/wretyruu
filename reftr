local function displayValue(value, depth)
	local kind = typeof(value)
	if kind == "string" then
		return string.format("%q", value)
	elseif kind == "buffer" then
		local length = buffer.len(value)
		local bytes = {}
		for offset = 0, math.min(length, 512) - 1 do
			bytes[#bytes + 1] = string.format("%02X", buffer.readu8(value, offset))
		end
		return string.format("buffer[%d] %s%s", length, table.concat(bytes, " "), length > 512 and " ... (truncated)" or "")
	elseif kind == "Instance" then
		return value:GetFullName()
	elseif kind == "table" and depth < 2 then
		local entries = {}
		for key, item in next, value do
			if #entries >= 16 then
				entries[#entries + 1] = "... (truncated)"
				break
			end
			entries[#entries + 1] = "[" .. displayValue(key, depth + 1) .. "]=" .. displayValue(item, depth + 1)
		end
		return "{" .. table.concat(entries, ", ") .. "}"
	end
	return tostring(value)
end

local function logSend(remote, groupName, remoteName, arguments, first, second)
	pcall(function()
		local values = {}
		for index = 1, arguments.n do
			values[index] = string.format("[%d]=%s", index, displayValue(arguments[index], 0))
		end
		consoleLine("[AssetContainer SEND] " .. remote:GetFullName() .. " (" .. remote.ClassName .. ")")
		consoleLine("[AssetContainer ROUTE] group=" .. displayValue(groupName, 0) .. " remote=" .. displayValue(remoteName, 0))
		consoleLine("[AssetContainer VALUES] " .. table.concat(values, ", "))
		consoleLine("[AssetContainer WIRE] arg1=" .. displayValue(first, 0) .. " arg2=" .. displayValue(second, 0))
	end)
end
